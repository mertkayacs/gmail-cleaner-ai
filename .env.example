# gmail-cleaner-ai configuration. Copy to .env and fill in.
# .env is gitignored; never commit real keys.

# -------- LLM model --------
# Any LiteLLM-supported model. Provider is inferred from the prefix
# (or absence, for OpenAI / Anthropic). Only the matching key var below
# needs to be set.
#
#   claude-opus-4-7                                     -> Anthropic
#   gpt-4o                                              -> OpenAI
#   gemini/gemini-2.5-pro                               -> Gemini
#   groq/llama-3.3-70b-versatile                        -> Groq
#   together_ai/meta-llama/Llama-3.3-70B-Instruct-Turbo -> Together AI
#   openrouter/anthropic/claude-opus-4-7                -> OpenRouter
#   mistral/mistral-large-latest                        -> Mistral
#   ollama/llama3.3                                     -> Ollama (local)
#   openai/<your-model>                                 -> any OpenAI-compatible
#                                                          local server (LM Studio,
#                                                          llama.cpp), set
#                                                          LLM_BASE_URL below
# Full list: https://docs.litellm.ai/docs/providers
LLM_MODEL=claude-opus-4-7

# Base URL for local OpenAI-compatible servers. Leave unset for cloud providers.
#   LM Studio default:    http://localhost:1234/v1
#   llama.cpp server:     http://localhost:8080/v1
# LLM_BASE_URL=

# Ollama host. Only needed if Ollama is not on localhost:11434.
# OLLAMA_HOST=http://localhost:11434

# -------- Provider keys --------
# Set the one matching your LLM_MODEL above. Leave the rest empty.
# Where to get each key:
#   Anthropic:   https://console.anthropic.com
#   OpenAI:      https://platform.openai.com/api-keys
#   Gemini:      https://aistudio.google.com/apikey
#   Groq:        https://console.groq.com/keys
#   Together AI: https://api.together.xyz/settings/api-keys
#   OpenRouter:  https://openrouter.ai/keys
#   Mistral:     https://console.mistral.ai/api-keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHERAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# -------- Gmail accounts --------
# Up to 20 supported. Number sequentially with matching APPPASS.
# App Passwords are generated at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification on the Google account).

GMAIL_ACCOUNT_1=primary@gmail.com
GMAIL_APPPASS_1=xxxxxxxxxxxxxxxx

# GMAIL_ACCOUNT_2=secondary@gmail.com
# GMAIL_APPPASS_2=xxxxxxxxxxxxxxxx

# Add more as needed: GMAIL_ACCOUNT_3, GMAIL_APPPASS_3, etc.
