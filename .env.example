# Provider selector. One of: anthropic, openai, gemini, ollama
LLM_PROVIDER=anthropic

# Optional override for the model name. Each provider has a sensible default.
#   anthropic default: claude-opus-4-7
#   openai default:    gpt-4o
#   gemini default:    gemini-2.5-pro
#   ollama default:    llama3.1:70b
# LLM_MODEL=

# Provider keys. Only the one matching LLM_PROVIDER is required.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
OLLAMA_HOST=http://localhost:11434

# Gmail accounts. Up to 20 supported. Number sequentially with matching APPPASS.
# App Passwords are generated at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification on the account).

GMAIL_ACCOUNT_1=primary@gmail.com
GMAIL_APPPASS_1=xxxxxxxxxxxxxxxx

GMAIL_ACCOUNT_2=secondary@gmail.com
GMAIL_APPPASS_2=xxxxxxxxxxxxxxxx

# Add more as needed: GMAIL_ACCOUNT_3, GMAIL_APPPASS_3, etc.
