# Anthropic API key (needed for `analyze` command). Get from console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...

# Gmail accounts. Up to 20 supported. Number sequentially with matching APPPASS.
# App Passwords are generated at https://myaccount.google.com/apppasswords (requires 2-Step Verification).

GMAIL_ACCOUNT_1=primary@gmail.com
GMAIL_APPPASS_1=xxxxxxxxxxxxxxxx

GMAIL_ACCOUNT_2=secondary@gmail.com
GMAIL_APPPASS_2=xxxxxxxxxxxxxxxx

# Add more as needed: GMAIL_ACCOUNT_3, GMAIL_APPPASS_3, etc.
